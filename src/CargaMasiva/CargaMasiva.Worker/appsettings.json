{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "reto-auth",
    "Audience": "reto-api"
  },
  "Seaweed": {
    "FilerUrl": "http://seaweedfs:8888/"
  },
  "RabbitMq": {
    "Host": "rabbitmq"
  }
}