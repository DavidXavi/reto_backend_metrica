{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "reto-auth",
    "Audience": "reto-api",
    "MinutosAcceso": 15,
    "DiasRefresh": 7
  }
}