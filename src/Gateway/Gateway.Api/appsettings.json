{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "reto-auth",
    "Audience": "reto-api"
  },
  "Cors": {
    "Origenes": [
      "http://localhost:5173"
    ]
  },
  "RateLimit": {
    "PorMinuto": 60,
    "LoginPorMinuto": 10
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/auth/{**resto}"
        }
      },
      "cargas": {
        "ClusterId": "control",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "por-usuario",
        "Match": {
          "Path": "/api/cargas/{**resto}"
        }
      },
      "datos": {
        "ClusterId": "carga",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "por-usuario",
        "Match": {
          "Path": "/api/datos/{**resto}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://auth:8080/"
          }
        }
      },
      "control": {
        "Destinations": {
          "d1": {
            "Address": "http://control:8080/"
          }
        }
      },
      "carga": {
        "Destinations": {
          "d1": {
            "Address": "http://carga:8080/"
          }
        }
      }
    }
  }
}